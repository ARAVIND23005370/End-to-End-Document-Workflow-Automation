# ===================================================================
# E2EDocs - Environment Configuration Template (.env.example)
# ===================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in the values for your target deployment environment.
# 3. NEVER commit real secrets or credentials to version control.
# ===================================================================

# -------------------------------------------------------------------
# Frontend Environment Configuration
# -------------------------------------------------------------------
VITE_APP_NAME=E2EDocs
VITE_API_BASE_URL=https://docflow-backend-fhv4.onrender.com/api
VITE_PUBLIC_SITE_URL=https://e2edocs.example.com

# -------------------------------------------------------------------
# Backend Server & Runtime Configuration
# -------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
E2EDOCS_SEED_ENABLED=false

# -------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# -------------------------------------------------------------------
# Direct host or pooler host (e.g. db.your-project.supabase.co or aws-0-region.pooler.supabase.com)
DB_HOST=db.ytchrjgkrygvfvdzdrfh.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_SSL_MODE=require
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# -------------------------------------------------------------------
# Security & JWT Configuration
# -------------------------------------------------------------------
# Minimum 256-bit (32+ alphanumeric characters) secret key
JWT_SECRET=YOUR_SECURE_JWT_SIGNING_SECRET_KEY_MINIMUM_256_BITS_HERE
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# CORS & Ingestion Configuration
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app,https://*.onrender.com

# -------------------------------------------------------------------
# Persistent Storage Mount Directory
# -------------------------------------------------------------------
# Local development default: uploads/
# Docker container default: /app/storage/
E2EDOCS_STORAGE_DIRECTORY=/app/storage/

# -------------------------------------------------------------------
# SMTP / Email Service Configuration
# -------------------------------------------------------------------
# SMTP delivery for rule-based emails and manual document sending
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@e2edocs.com
MAIL_FROM_NAME=E2EDocs Platform

# -------------------------------------------------------------------
# Structured Logging Levels
# -------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
